{
    "name": "merchant-cash-advance",
    "version": "1.0.0",
    "private": true,
    "description": "Daily billing simulation for merchant cash advances",
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "start": "node src/main.ts",
        "test": "tsc && node --test \"test/**/*.test.ts\"",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' \"test/**/*.test.ts\"",
        "typecheck": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "prettier": "^3.6.0",
        "typescript": "^6.0.0"
    }
}
